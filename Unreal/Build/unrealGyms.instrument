<?xml version="1.0" encoding="ISO-8859-1"?>
<instrument rootdir="../../../"
	xmlns:ak="file://instrument/tasks/ak"
	xmlns:wwise="file://instrument/tasks/wwise"
	xmlns:scripts="file://instrument/tasks/scripts">

	<!-- Distribute files -->
	<property name="GYMS_DISTRIBUTE_FILE" value="Gyms/Unreal/Build/UnrealGyms.distribute" />

	<target name="fetch_sdk">
		<if condition="${platform.is_darwin()}">
			<wwise:getsdk wwise-version="${WWISE_VERSION}" specific-build="${WWISE_BUILD_NUMBER}" wwise-root="${_root_directory_}/Wwise" builds-root="/mnt/DC1/Files/Builds" working-directory="${_root_directory_}/Gyms/Unreal/Plugins/WwiseSoundEngine/ThirdParty" platforms="Mac,Main" />	
			<wwise:getplugins wwise-version="${WWISE_VERSION}" specific-build="${WWISE_BUILD_NUMBER}" wwise-root="${_root_directory_}/Wwise" builds-root="/mnt/DC1/Files/Builds" working-directory="${_root_directory_}/Gyms/Unreal/Plugins/WwiseSoundEngine/ThirdParty" platforms="Mac" plugin-names="Auro,ConvolutionReverb,Reflect,MasteringSuite,SoundSeedGrain" />	
		</if>

		<if condition="${platform.is_windows()}">
			<wwise:getsdk wwise-version="${WWISE_VERSION}" specific-build="${WWISE_BUILD_NUMBER}" wwise-root="${_root_directory_}/Wwise" builds-root="${BUILDS_LOCATION}" working-directory="${_root_directory_}/Gyms/Unreal/Plugins/WwiseSoundEngine/ThirdParty" platforms="Windows_vc150,Windows_vc160,Windows_vc170,Main"/>	
			<wwise:getplugins wwise-version="${WWISE_VERSION}" specific-build="${WWISE_BUILD_NUMBER}" wwise-root="${_root_directory_}/Wwise" builds-root="${BUILDS_LOCATION}" working-directory="${_root_directory_}/Gyms/Unreal/Plugins/WwiseSoundEngine/ThirdParty" platforms="Windows_vc150,Windows_vc160,Windows_vc170" plugin-names="Auro,ConvolutionReverb,Reflect,MasteringSuite,SoundSeedGrain"/>	
		</if>
	</target>

	<target name="build_game">
		<scripts:python script-path="${_ROOT_DIRECTORY_}/Gyms/Unreal/Build/BuildGyms.py" />
	</target>
</instrument>